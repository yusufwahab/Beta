# Copy apps/web/.env.example to apps/web/.env and server/.env.example to server/.env.
# Frontend variables are public. Never place backend keys in VITE_ variables.
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
PORT=5000
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Backend-only direct Brevo API email delivery.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Beta
DATABASE_URL=
NATLAS_BASE_URL=
NATLAS_API_KEY=
NATLAS_ASR_MODEL_EN=NCAIR1/NigerianAccentedEnglish
NATLAS_ASR_MODEL_YO=NCAIR1/Yoruba-ASR
NATLAS_ASR_MODEL_HA=NCAIR1/Hausa-ASR
NATLAS_ASR_MODEL_IG=NCAIR1/Igbo-ASR

# Dynamic responses only; obtain a YarnGPT API key and language-appropriate voice IDs.
YARNGPT_API_KEY=
YARNGPT_VOICE_EN=
YARNGPT_VOICE_YO=
YARNGPT_VOICE_HA=
YARNGPT_VOICE_IG=
SENTRY_DSN=
