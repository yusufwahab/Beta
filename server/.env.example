PORT=5000
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct backend email delivery through Brevo's API (backend-only).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Beta
# Supabase session pooler or direct PostgreSQL URL. Use SSL as specified by Supabase.
# This connection role must be allowed to SET ROLE beta_api (migration grants postgres).
DATABASE_URL=
# Run pending SQL migrations before the API starts; failure prevents startup.
AUTO_MIGRATE=false
# Optional privileged direct/session-pooler URL for migrations; defaults to DATABASE_URL.
# Keep this backend-only. The account needs schema/role creation permissions.
MIGRATION_DATABASE_URL=
NATLAS_BASE_URL=
NATLAS_API_KEY=
NATLAS_ASR_MODEL_EN=NCAIR1/NigerianAccentedEnglish
NATLAS_ASR_MODEL_YO=NCAIR1/Yoruba-ASR
NATLAS_ASR_MODEL_HA=NCAIR1/Hausa-ASR
NATLAS_ASR_MODEL_IG=NCAIR1/Igbo-ASR
# Render commonly requires 1; keep 0 for direct local access.
TRUST_PROXY_HOPS=0

# Dynamic responses only; obtain a YarnGPT API key and language-appropriate voice IDs.
YARNGPT_API_KEY=
YARNGPT_VOICE_EN=
YARNGPT_VOICE_YO=
YARNGPT_VOICE_HA=
YARNGPT_VOICE_IG=
SENTRY_DSN=

# off disables tracking; test is excluded from live evidence. Set live for real-user trials.
VALIDATION_MODE=test

# Public frontend origin used only for validation invitation links (no trailing path).
VALIDATION_INVITE_BASE_URL=
